{
  "name": "env-lens",
  "displayName": "ENV Lens",
  "description": "Validate and sync .env files in the editor.",
  "version": "0.0.1",
  "packageManager": "pnpm@12.1.0",
  "publisher": "gvastethecreator",
  "author": {
    "name": "gvastethecreator"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/env-lens.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/env-lens/issues"
  },
  "homepage": "https://github.com/gvastethecreator/env-lens#readme",
  "keywords": [
    "dotenv",
    "env",
    "environment variables",
    ".env",
    "validation"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "envLens.validateCurrentFile",
        "title": "Validate Current File",
        "category": "ENV Lens"
      },
      {
        "command": "envLens.compareWithExample",
        "title": "Compare with Example",
        "category": "ENV Lens"
      },
      {
        "command": "envLens.addMissingKeysToExample",
        "title": "Add Missing Keys to Example",
        "category": "ENV Lens"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "vsix": "pnpm run package && vsce package --no-dependencies",
    "check-types": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
